{
  "name": "studyroom-scrum-lab",
  "version": "1.0.0",
  "private": true,
  "description": "바이브 코딩 시대의 스크럼 — 90분 팀 스프린트 실습 저장소 (스터디룸 예약 서비스)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test --test-force-exit --test-timeout=10000 \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm test && npm run check:secrets"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
